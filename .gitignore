# Root .gitignore for vegetable-shop (frontend + backend monorepo)

# ======================= OS / IDE =======================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.iml

# ======================= Archives =======================
*.zip
*.rar
*.tar.gz
*.7z

# ======================= Frontend (Next.js / Node) =======================
**/node_modules/
**/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
**/coverage/

# next.js
**/.next/
**/out/

# production
**/build/

# vercel
.vercel/

# typescript
*.tsbuildinfo
**/next-env.d.ts

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — keep templates
.env
.env.*
!.env.example
!.env.*.example

# ======================= Backend (Spring Boot / Maven) =======================
**/target/
**/.flattened-pom.xml
**/dependency-reduced-pom.xml
**/surefire-reports/
**/failsafe-reports/
**/jacoco.exec
**/jacoco/*.exec
**/site/

# Spring config (real files) — allow examples
#backend/src/main/resources/application.yml
#backend/src/main/resources/application.properties
#backend/src/main/resources/application-*.yml
#backend/src/main/resources/application-*.properties
#!backend/src/main/resources/application.yml.example
#!backend/src/main/resources/application.properties.example

# certificates / keys
*.keystore
*.p12
*.jks
*.pem
*.crt
*.key

# ======================= Logs & runtime =======================
logs/
*.log
*.hprof
*.jfr
spring.log
nohup.out
*.pid
*.seed

# ======================= Temp & caches =======================
tmp/
temp/
**/.cache/
.cache/
dist/
bin/
.gen/
.generated/
generated/
**/generated-sources/

# ======================= Docs & OpenAPI (optional) =======================
.openapi-temp/
.openapi-diff-old.yaml

# ======================= Misc =======================
*.local
*.bak
*.orig
*.rej
